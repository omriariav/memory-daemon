<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Optional Mila trigger: runs the Mila routine shortly after Mila writes
     recordings.json instead of waiting for the next tick. WatchPaths fires on
     every write, so `--if-pending` exits without taking the run lock when no
     completed recording is unprocessed, and `--wait-lock` queues behind a busy
     tick rather than dropping the trigger. ThrottleInterval coalesces bursts to
     at most one launch a minute. Render beside the primary plist; the pause
     switch (state/PAUSED) and the routine's budget caps still apply. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.memory-daemon-mila</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__REPO_DIR__/daemon.py</string>
        <string>run</string>
        <string>--routine</string>
        <string>mila-meetings</string>
        <string>--if-pending</string>
        <string>--wait-lock</string>
        <string>600</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <key>WatchPaths</key>
    <array>
        <string>__MILA_RECORDINGS__</string>
    </array>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/dev/null</string>

    <key>StandardErrorPath</key>
    <string>/dev/null</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/node-current/bin:/opt/homebrew/bin:/usr/local/bin:__HOME__/.local/bin:__HOME__/go/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
